{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --test \".test-build/test/unit/*.test.js\"",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \".test-build/test/integration/*.test.js\"",
    "bench": "tsc -p tsconfig.test.json && node .test-build/test/bench/import-bench.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
