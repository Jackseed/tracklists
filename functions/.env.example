# Copy to functions/.env.<firebase project id> and fill in. These files are read by
# `firebase deploy` and by the emulators; they are not committed.
#
# The Spotify client secret is NOT set here. For a deployed project:
#   firebase functions:secrets:set SPOTIFY_CLIENT_SECRET --project <project id>
# For the emulators, put it in functions/.secret.local:
#   SPOTIFY_CLIENT_SECRET=...

# Client ID of the Spotify app (developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=

# Redirect URI used when the web app does not send its own. Must be registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=https://example.com/login

# Service account that signs the Firebase custom tokens:
# firebase-adminsdk-xxxxx@<project id>.iam.gserviceaccount.com
# (Firebase console > Project settings > Service accounts). The account running the
# functions needs the "Service Account Token Creator" role on it.
CUSTOM_TOKEN_SERVICE_ACCOUNT=

# Optional. Account the functions run as; defaults to <project id>@appspot.gserviceaccount.com,
# the identity of the former 1st-gen functions.
# FUNCTIONS_SERVICE_ACCOUNT=

# Optional. Pace of the library import (it also slows down by itself when Spotify answers 429).
# SPOTIFY_MAX_REQUESTS_PER_SECOND=10
# SPOTIFY_MAX_CONCURRENT_REQUESTS=6
