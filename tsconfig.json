/* To learn more about this file see: https://angular.dev/reference/configs/file-structure#typescript-configuration */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    /* The code base predates strict mode: turning it on is a project of its own. */
    "strict": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "dom"],
    /* Required by Akita and by field initialisers that read constructor parameters. */
    "useDefineForClassFields": false,
    /* Explicit list: do not pick up stray @types from parent folders. */
    "types": []
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": false
  }
}
